.DS_Store
*.swp
*.zwc
zsh/.zcompdump
.env
.env.*
!.env.example
!.env.*.example
node_modules
__pycache__/
*.py[cod]
.cache/
hypr/.config/hypr/host.conf
hypr/.config/hypr/host.lua

# These packages target directories that hold keys, credentials, and agent
# transcripts. Track only the intended files, even if a directory was ever
# folded into the repository by Stow.
ssh/.ssh/*
!ssh/.ssh/config
agents/.claude/*
!agents/.claude/CLAUDE.md
!agents/.claude/hooks/
agents/.codex/*
!agents/.codex/AGENTS.md
git/.config/git/*
!git/.config/git/ignore

# Stray backups left by tools and agents before an edit.
*.t3-capture-backup-*
*.before-*
