# Shared SSH client defaults. This repository is public, so host aliases with
# personal user names and host names go in ~/.ssh/config.d/ (not tracked).
Include config.d/*

Host *
    # Reuse one authenticated connection per host for ten minutes: later ssh,
    # scp, rsync, and git commands to that host start without re-authenticating.
    ControlMaster auto
    ControlPath ~/.ssh/cm-%C
    ControlPersist 10m
    # Keep idle sessions alive through Wi-Fi and NAT timeouts.
    ServerAliveInterval 30
    ServerAliveCountMax 4
    # Unlock a passphrase-protected key once per login through the agent.
    AddKeysToAgent yes
